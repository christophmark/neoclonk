+/* Network interchange for one client (host or client side) */
+
+#include <C4Include.h>
+
+const int C4NET_Transfer_None = 0, C4NET_Transfer_Cease = 1, C4NET_Transfer_GetNetReady = 2, C4NET_Transfer_SendNetGo = 3;
