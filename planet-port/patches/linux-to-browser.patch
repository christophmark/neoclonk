-    mat[15] = 1.0f;
-    return;
-  }
-  mat[0] = 2.0f / (right - left);
-  mat[5] = 2.0f / (top - bottom);
-  mat[10] = -1.0f;
-  mat[12] = -(right + left) / (right - left);
-  mat[13] = -(top + bottom) / (top - bottom);
-  mat[15] = 1.0f;
-}
