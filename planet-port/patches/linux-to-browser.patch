+void C4Def::Clear() {
+  if (Picture)
+    DeleteBitmap(Picture);
+  Picture = NULL;
+  if (Image)
+    DeleteBitmap(Image);
+  Image = NULL;
+
+#ifdef C4ENGINE // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+                // - - - - - - - - - - - - - - - - -
+  for (int cnt = 0; cnt < C4MaxColor; cnt++)
+    if (Bitmap[cnt]) {
+      DestroySurface(Bitmap[cnt]);
+      Bitmap[cnt] = NULL;
+    }
+
+  Script.Clear();
+#endif // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+       // - - - - - - - - - - - - -
+
+  if (ActMap)
+    delete[] ActMap;
+  ActMap = NULL;
+  if (Desc)
+    delete[] Desc;
+  Desc = NULL;
+}
