-int C4Stream::GetPacket(C4Packet &rPacket) {
-  rPacket.Reset();
-  if (!pStream->good()) {
-    return C4STRM_NoGood;
-  }
-  // Get header
-  for (int cnt = 0; cnt < sizeof(C4PacketHeader); cnt++) {
