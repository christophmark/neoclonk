+void C4MaterialList::Add(int iMaterial, int iAmount) {
+  if (!Inside(iMaterial, 0, C4MaxMaterial))
+    return;
+  Amount[iMaterial] += iAmount;
+}
+
+int C4MaterialList::Get(int iMaterial) {
+  if (!Inside(iMaterial, 0, C4MaxMaterial))
+    return 0;
+  return Amount[iMaterial];
