+  // Set out of sync
+  pClient->OutOfSync = TRUE;
+  sprintf(OSTR, LoadResStr(IDS_NET_SYNCLOSS), pClient->Name);
+  Log(OSTR);
+  SoundEffect("SyncError");
+  // Update console
+  Console.UpdateMenus();
+  // Success
+  return TRUE;
+}
