+C4NetworkClient *C4Network::GetClientByName(const char *szName) {
+  // Host can do this only
+  if (!Active || !Host)
+    return NULL;
+  // Check client list
+  for (C4NetworkClient *pClient = Clients.First; pClient; pClient = pClient->Next)
+    if (SEqualNoCase(pClient->Name, szName))
+      return pClient;
+  // No match
+  return NULL;
+}
