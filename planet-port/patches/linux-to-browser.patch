+  InAction = TRUE;
+#ifdef C4ENGINE // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+                // - - - -
+  InActionTime = Game.Time;
+#endif // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+       // - - - - -
+}
+
+void C4ObjectInfo::Retire() {
+  InAction = FALSE;
+#ifdef C4ENGINE // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+                // - - - -
+  TotalPlayingTime += (Game.Time - InActionTime);
+#endif // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+       // - - - - -
+}
