-BOOL FileExists(const char *szFilename, int *lpAttr) {
-  struct _finddata_t fdt;
-  intptr_t shnd;
-  if ((shnd = _findfirst((char *)szFilename, &fdt)) < 0)
-    return FALSE;
-  _findclose(shnd);
-  if (lpAttr)
-    *lpAttr = fdt.attrib;
-  return TRUE;
-}
