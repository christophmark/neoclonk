+void C4PhysicalInfo::PromotionUpdate(int iRank) {
+  if (iRank >= 0) {
+    CanDig = 1;
+    CanChop = 1;
+    CanConstruct = 1;
+  }
+  if (iRank >= 4) {
+    CanScale = 1;
+  }
+  if (iRank >= 6) {
+    CanHangle = 1;
+  }
+  Energy = Max(Energy, (50 + 5 * BoundBy(iRank, 0, 10)) * C4MaxPhysical / 100);
+}
