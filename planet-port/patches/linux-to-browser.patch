-
-#ifndef _WIN32
-  pthread_cleanup_push(HostThreadCleanup, pListener);
-#endif
-
-  // Host thread loop
-  while (!fTerminate) {
-    // Await client & connect
-    printf("Host: Awaiting client connection...\n");
-    iResult = pListener->Connect(Config.Network.LocalName, C4STRM_Listener, NULL, &pStrm);
