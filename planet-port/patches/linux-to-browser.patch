+  if (iClient == GetClientNumber())
+    return LocalName;
+  // Invalid
+  if (!Active || (iClient == C4NET_NoClient))
+    return "No client";
+  // Search client (host only for now)
+  C4NetworkClient *pClient = NULL;
+  if (Host)
+    pClient = Clients.Get(iClient);
