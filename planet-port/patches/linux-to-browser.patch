+void CStdDDraw::Clear() {
+  if (std::this_thread::get_id() != g_mainThreadId)
+    return;
+  DebugLog("DDraw Clear");
+  if (g_window) {
+    glfwDestroyWindow(g_window);
+    g_window = NULL;
+  }
+  glfwTerminate();
+}
