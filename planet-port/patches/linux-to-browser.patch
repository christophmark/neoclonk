+BOOL C4MaterialCore::Load(C4Group &hGroup, const char *szEntryName) {
+  BYTE *pSource;
+  if (!hGroup.LoadEntry(szEntryName, &pSource, NULL, 1))
+    return FALSE;
+  if (!Compile((char *)pSource)) {
+    delete[] pSource;
+    return FALSE;
+  }
+  delete[] pSource;
+  return TRUE;
+}
