+const int C4MN_Frame_Left = 1, C4MN_Frame_Right = 2, C4MN_Frame_Top = 4, C4MN_Frame_Bottom = 8, C4MN_Frame_Border = C4MN_Frame_Left | C4MN_Frame_Right | C4MN_Frame_Top | C4MN_Frame_Bottom,
