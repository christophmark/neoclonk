+  SURFACE ns = CreateSurface(s->w, s->h);
+  if (!ns)
+    return NULL;
+  CGLSurface *ns2 = (CGLSurface *)ns;
+  
+  SyncSurfaceCPU(s);
+  
+  memcpy(ns2->bits, s->bits, s->pitch * s->h);
+  ns2->dirty_cpu = true;
+  return ns;
+}
