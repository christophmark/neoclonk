-#endif // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
-       // - - - - - - - - - - - - - - - - -
-
-  // Load primary definition
-  if (nDef = new C4Def)
-    if (nDef->Load(hGroup, dwLoadWhat, szLanguage, pSoundSystem) && Add(nDef, fOverload)) {
-      iResult++;
