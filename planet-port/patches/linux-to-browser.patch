+BOOL C4ControlQueue::Save(C4Group &hGroup) {
+  // Save to temp file
+  if (!C4Packet::Save(Config.AtTempPath(C4CFN_ControlQueue)))
+    return FALSE;
+  // Move temp file to group
+  if (!hGroup.Move(Config.AtTempPath(C4CFN_ControlQueue)))
+    return FALSE;
+  // Success
+  return TRUE;
+}
