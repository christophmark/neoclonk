-BOOL WildcardMatch(const char *szWildcard, const char *szFilename) {
-
-  char tfname1[_MAX_FNAME + 1], tfname2[_MAX_FNAME + 1];
-  char tfext1[10 + 1], tfext2[10 + 1];
-
-  SCopy(GetFilename(szWildcard), tfname1, _MAX_FNAME);
-  SCapitalize(tfname1);
