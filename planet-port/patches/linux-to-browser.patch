+  C4Player *pPlr;
+  if (pPlr = Game.Players.Get(Player))
+    pPlr->ObjectCommand(Command, Game.Objects.ObjectPointer(Target), X, Y, Game.Objects.ObjectPointer(Target2), Data, AddMode);
