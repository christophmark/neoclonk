+void C4Menu::Clear() {
+  Symbol.Clear();
+  Buffer.Clear();
+  Regions.Clear();
+  C4MenuItem *pNext;
+  while (First) {
+    pNext = First->Next;
+    delete First;
+    First = pNext;
+  }
+}
+
+void C4Menu::Close() {
+  Clear();
+  Active = FALSE;
+}
