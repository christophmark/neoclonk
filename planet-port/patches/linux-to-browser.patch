-int FileAttributes(const char *szFilename) {
-  struct _finddata_t fdt;
-  intptr_t shnd;
-  if (!szFilename)
-    return 0;
-  if ((shnd = _findfirst((char *)szFilename, &fdt)) < 0)
-    return 0;
-  _findclose(shnd);
-  return fdt.attrib;
-}
