-  for (cdef = FirstDef, prev = NULL; cdef; prev = cdef, cdef = cdef->Next)
-    if (cdef->id == id) {
-      if (prev)
-        prev->Next = cdef->Next;
-      else
-        FirstDef = cdef->Next;
-      delete cdef;
-      return TRUE;
-    }
-  return FALSE;
