+    DarkColorTable[iColor] =
+        FindPaletteColor(bypPalette, Max(bypPalette[iColor * 3 + 0] - iDarkening, 0), Max(bypPalette[iColor * 3 + 1] - iDarkening, 0), Max(bypPalette[iColor * 3 + 2] - iDarkening, 0));
