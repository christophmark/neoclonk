+
+  dwXPos = 32768;
+  dwYPos = 32768;
+  if (axes && axis_count >= 2) {
+    dwXPos = (DWORD)((axes[0] + 1.0f) * 32767.5f);
+    dwYPos = (DWORD)((axes[1] + 1.0f) * 32767.5f);
+  }
+
+  return TRUE;
+}
+
+int GetFirstSetBit(DWORD dwBitArray) {
+  for (int bitn = 0; bitn < 32; bitn++)
+    if (dwBitArray & ((DWORD)1 << bitn))
+      return bitn;
+
+  return -1;
+}
