-    return FALSE;
-  // Allocate and set new ray
-  CPathFinderRay *pRay;
-  if (!(pRay = new CPathFinderRay))
-    return FALSE;
-  pRay->X = iFromX;
-  pRay->Y = iFromY;
-  pRay->X2 = iFromX;
-  pRay->Y2 = iFromY;
-  pRay->TargetX = iToX;
-  pRay->TargetY = iToY;
-  pRay->Depth = iDepth;
-  pRay->Direction = iDirection;
-  pRay->From = pFrom;
-  pRay->pPathFinder = this;
-  pRay->Next = FirstRay;
-  FirstRay = pRay;
-  return TRUE;
-}
