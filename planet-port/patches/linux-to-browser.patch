+BYTE CStdDDraw::GetPixel(SURFACE sfcSource, int fx, int fy) {
+  if (!sfcSource)
+    return 0;
+  CGLSurface *src = (CGLSurface *)sfcSource;
+  SyncSurfaceCPU(src);
+  if (fx >= 0 && fx < src->w && fy >= 0 && fy < src->h) {
+    return src->bits[fy * src->pitch + fx];
+  }
+  return 0;
+}
