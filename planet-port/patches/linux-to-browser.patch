+void C4GraphicsSystem::Clear() {
+  // Clear message board
+  MessageBoard.Clear();
+  // Clear loader
+  fctLoader.Clear();
+  // Close viewports
+  C4Viewport *next;
+  while (FirstViewport) {
+    next = FirstViewport->Next;
+    delete FirstViewport;
+    FirstViewport = next;
+  }
+  FirstViewport = NULL;
+  // Clear video system
+  Video.Clear();
+}
