-    if (!pStream->good()) {
-      return C4STRM_NoGood;
-    }
-  }
-  // Put data
-  int iPrcBlock = 0;
-  for (int cnt = 0; cnt < rPacket.Size; cnt++) {
-    if (!rPacket.Data)
-      return C4STRM_NoData;
-    pStream->put(rPacket.Data[cnt]);
-    if (!pStream->good()) {
-      return C4STRM_NoGood;
