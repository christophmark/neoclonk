-BOOL C4Scenario::Load(C4Group &hGroup) {
-  BYTE *pSource;
-  // Load
-  if (!hGroup.LoadEntry(C4CFN_ScenarioCore, &pSource, NULL, 1))
-    return FALSE;
-  // Compile
-  if (!Compile((char *)pSource)) {
-    delete[] pSource;
-    return FALSE;
-  }
-  delete[] pSource;
-  // Convert
-  Game.ConvertGoals(Realism);
-  // Success
-  return TRUE;
