+BOOL C4PlayerInfoCore::CheckPromotion(C4RankSystem &rRanks) {
+  if (Score >= rRanks.Experience(Rank + 1)) {
+    Promote(Rank + 1, rRanks);
+    return TRUE;
+  }
+  return FALSE;
