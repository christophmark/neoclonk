-BOOL CPathFinder::Execute() {
-
-  // Execute & count rays
-  BOOL fContinue = FALSE;
-  int iRays = 0;
-  for (CPathFinderRay *pRay = FirstRay; pRay && !Success; pRay = pRay->Next, iRays++)
-    if (pRay->Execute())
-      fContinue = TRUE;
-
-  // Max ray limit
-  if (iRays >= MaxRay)
-    return FALSE;
-
-  return fContinue;
-}
