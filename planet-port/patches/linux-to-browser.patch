+BOOL CStdDDraw::SetPixel(SURFACE sfcDest, int tx, int ty, BYTE col) {
+  if (!sfcDest)
+    return FALSE;
+  CGLSurface *dst = (CGLSurface *)sfcDest;
+  SyncSurfaceCPU(dst);
+  if (tx >= 0 && tx < dst->w && ty >= 0 && ty < dst->h) {
+    dst->bits[ty * dst->pitch + tx] = col;
+    dst->dirty_cpu = true;
+  }
+  return TRUE;
+}
