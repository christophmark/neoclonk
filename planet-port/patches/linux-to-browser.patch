+BOOL C4Rect::Overlap(C4Rect &rTarget) {
+  if (x + Wdt - 1 < rTarget.x)
+    return FALSE;
+  if (x > rTarget.x + rTarget.Wdt - 1)
+    return FALSE;
+  if (y + Hgt - 1 < rTarget.y)
+    return FALSE;
+  if (y > rTarget.y + rTarget.Hgt - 1)
+    return FALSE;
+  return TRUE;
+}
