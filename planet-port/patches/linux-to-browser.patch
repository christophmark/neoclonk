+C4Menu::C4Menu() { Default(); }
+
+C4Menu::~C4Menu() { Clear(); }
+
+void C4Menu::Default() {
+  Active = FALSE;
+  Selection = -1;
+  Style = C4MN_Style_Normal;
+  ItemCount = 0;
+  ItemWidth = ItemHeight = C4SymbolSize;
+  First = NULL;
+  Redraw = TRUE;
+  NeedRefill = FALSE;
+  Symbol.Default();
+  Caption[0] = 0;
+  Player = NO_OWNER;
+  Permanent = FALSE;
+  Object = NULL;
+  Extra = C4MN_Extra_None;
+  ExtraData = 0;
+  Position = 0;
+  TimeOnSelection = 0;
+  VisibleCount = 0;
+  Identification = 0;
+  LocationSet = FALSE;
+  RefillObjectContentsCount = 0;
+  X = Y = Width = Height = 0;
+  CloseDown = FALSE;
+  ParentObject = NULL;
+  RefillObject = NULL;
+  Columns = Lines = 0;
+  Multiline = Scrollbar = FALSE;
+  DragScrollRange1 = DragScrollRange2 = 0;
+  Alignment = C4MN_Align_Right | C4MN_Align_Bottom;
+  Buffer.Default();
+  Regions.Default();
+  CaptionPlace.Default();
+  CaptionText[0] = 0;
+  InfoCaptionPlace.Default();
+  InfoCaptionText[0] = 0;
+  EnableInfoCaption = FALSE;
+}
