# Redis: choose REST (Vercel) or local TCP (single VM). Never expose Redis publicly.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=
REDIS_NAMESPACE=neoclonk:lobby:v1
ALLOWED_ORIGINS=https://neoclonk.chris270130.chatgpt.site,http://192.168.178.82:3000,http://localhost:3000
LOBBY_ENABLED=true
# Conservative application admission caps, NOT a platform resource/spending cap.
LOBBY_REQUEST_LIMIT=20000
LOBBY_BYTE_LIMIT=1073741824
LOBBY_IP_PER_MINUTE=180
TURN_PROVIDER=coturn
TURN_SHARED_SECRET=
TURN_URLS=turn:relay.example.com:3478?transport=udp,turn:relay.example.com:3478?transport=tcp,turns:relay.example.com:5349?transport=tcp
TURN_TTL_SECONDS=14400
# Cloudflare alternative:
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Node process behind a trusted reverse proxy which overwrites X-Forwarded-For:
TRUST_PROXY=false
HOST=127.0.0.1
PORT=8787
