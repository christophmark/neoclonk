+// Compatibility boundary for Emscripten's SDL1/Web Audio mixer emulation.
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <climits>
+#ifndef C4_BROWSER_AUDIO_PARSER_ONLY
+#include <C4Include.h>
+#include <C4Application.h>
+#include <C4MusicSystem.h>
+#include <SDL_mixer.h>
+#include <emscripten/emscripten.h>
