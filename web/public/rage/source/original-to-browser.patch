+      else if(!memcmp(data+pos,"fact",4) && length>=4)factSamples=AudioU32(data+body);
+      pos=body+length+(length&1u);
+    }
+    if(factSamples)return AudioDuration(factSamples,rate,rate,milliseconds,sampleRate,legacyLength);
